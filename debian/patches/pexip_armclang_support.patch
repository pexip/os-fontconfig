Adds support for armclang compiler
--- fontconfig.orig/src/meson.build
+++ fontconfig/src/meson.build
@@ -35,6 +35,8 @@ if cc.get_argument_syntax() == 'gcc'
   cpp += ['-E', '-P']
 elif cc.get_argument_syntax() == 'msvc'
   cpp += ['/EP']
+elif ['clang', 'armltdclang'].contains(cc.get_argument_syntax())
+  cpp += ['-E', '-P']
 else
   error('FIXME: implement cc.preprocess')
 endif
